# Database Configuration
DB_NAME=your_db_name
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db:5432/your_db_name

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=

# API Configuration
API_BASE_URL=http://app:8000
# Leave empty in Docker to use same-origin Nginx proxy from the browser.
VITE_API_BASE_URL=

# JWT Configuration
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
